APP_ENV=development
APP_NAME=合约风控台
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=postgresql+asyncpg://trading@postgres:5432/trading
REDIS_URL=redis://redis:6379/0
AUTH_REQUIRED=false
AUTH_USERNAME=admin
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]
BINANCE_ENVIRONMENT=testnet
BINANCE_TESTNET_BASE_URL=https://testnet.binancefuture.com
BINANCE_LIVE_BASE_URL=https://fapi.binance.com
BINANCE_WS_TESTNET_URL=wss://stream.binancefuture.com
BINANCE_WS_LIVE_URL=wss://fstream.binance.com
BINANCE_STOP_PRICE_PROTECT=false
HTTP_PROXY_ENABLED=false
# Optional split egress: keep Binance direct if the proxy IP is rate-limited.
BINANCE_HTTP_PROXY_ENABLED=false
MODEL_BASE_URL=
MODEL_NAME=gpt-5.6
MODEL_PROFILE=relay
VLLM_MODEL_BASE_URL=
VLLM_MODEL_NAME=Qwen/Qwen3.8-27B-FP8
VLLM_MODEL_LABEL=自建 vLLM
MODEL_REASONING_EFFORT=medium
MODEL_TIMEOUT_SECONDS=120
STRATEGY_PROFILE=trend_following
CAPITAL_LIMIT_USDT=1000
# Testnet acceptance profile: active but bounded. Live mode rejects these
# aggressive values and requires explicit conservative limits.
SINGLE_TRADE_RISK_PCT=0.004
PORTFOLIO_RISK_PCT=0.012
MAX_LEVERAGE=30
MAX_POSITIONS=4
CANDIDATE_COUNT=8
SCAN_INTERVAL_MINUTES=5
MIN_STOP_ATR=0.8
MAX_STOP_ATR=4.0
MANUAL_EXIT_LEVELS_ENABLED=true
MANUAL_STOP_ATR=1.8
MANUAL_TAKE_PROFIT_ATR=5.0
# Testnet opportunity-policy exception: a strong aligned uptrend may skip
# the 15m trigger, while all liquidation-prevention limits remain enforced.
STRONG_TREND_ENTRY_OVERRIDE_ENABLED=true
STRONG_TREND_ADX_MIN=30
PORTFOLIO_STRATEGY_ENABLED=true
PORTFOLIO_REBALANCE_DEADBAND_FRACTION=0.10
PORTFOLIO_REBALANCE_COOLDOWN_MINUTES=30
# HFT is an independent testnet shadow module. Keep real execution disabled.
HFT_ENABLED=false
HFT_DRY_RUN=true
HFT_SYMBOLS=BTCUSDT,ETHUSDT
HFT_EVENT_INTERVAL_MS=100
HFT_MAX_SPREAD_PCT=0.0008
HFT_MIN_DEPTH_USDT=25000
HFT_ORDER_NOTIONAL_USDT=50
HFT_MAX_INVENTORY_USDT=250
HFT_COOLDOWN_SECONDS=3
HFT_MARKET_STALE_SECONDS=2
HFT_MAX_CONSECUTIVE_LOSSES=3
HFT_IMBALANCE_THRESHOLD=0.20
TREND_ADX_MIN=20
VOLATILITY_SOFT_LIMIT_PERCENTILE=0.75
VOLATILITY_HARD_LIMIT_PERCENTILE=0.90
ELEVATED_VOLATILITY_RISK_MULTIPLIER=0.75
HIGH_VOLATILITY_RISK_MULTIPLIER=0.50
DOMAIN=localhost
